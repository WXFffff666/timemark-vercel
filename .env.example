# TimeMark Vercel — Environment Variables
# Copy to .env for local dev, or set in Vercel Dashboard → Settings → Environment Variables

# === Required ===
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your-64-char-hex-secret
MASTER_KEY=your-64-char-hex-aes-key
CRON_SECRET=your-random-cron-secret

# === Recommended ===
NODEJS_HELPERS=0
CORS_ORIGIN=https://your-app.vercel.app
TZ=Asia/Shanghai

# === Optional (login bot protection) ===
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# See docs/TURNSTILE_SETUP.md — create widget for timemark.the37777777.top

# === Optional ===
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=TimeMark@2026
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LOG_LEVEL=info
LOG_QUERIES=false

# === Optional — Google 日历 OAuth 只读同步（不配不影响其他功能）===
# 详见 docs/GOOGLE_CALENDAR_OAUTH.md
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://你的域名/api/calendar/google-oauth/callback

# === Optional — AI 助手 / 向量检索（先接入、默认全部关闭；留空即禁用，不配置不影响任何功能）===
# OpenAI 兼容接口；主用 + 备用回退。免费云端（Groq/Gemini/OpenRouter 等）或本地模型均可。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# 本地模型（Ollama）OpenAI 兼容端点
OLLAMA_BASE_URL=http://localhost:11434/v1
# 嵌入/向量检索为可选功能，默认关闭；开启后才会把文本发往嵌入服务
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_ENABLED=false

# === Optional — Agent 工具 API / MCP 服务端 / Workflows（默认全部关闭）===
AGENT_TOOLS_ENABLED=false
MCP_ENABLED=false
MCP_AUTH_TOKEN=
WORKFLOWS_ENABLED=false

# === Optional — Telegram 双向机器人 ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# === Optional — 对象存储（Vercel Blob，用于附件）===
BLOB_READ_WRITE_TOKEN=

# === Optional — 浏览器 Web Push（PUSH_VAPID_* 为规范命名；上方 VAPID_* 为兼容保留）===
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# === Optional — Firebase Cloud Messaging HTTP v1（也可在渠道页按账号配置）===
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Generate secrets (PowerShell):
# -join ((1..64) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
